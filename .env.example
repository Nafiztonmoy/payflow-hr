# PayFlow HR Environment Configuration Template
POSTGRES_DB=payflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5434

# API Configuration
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5434;Database=payflow_db;Username=postgres;Password=postgres
